# Dependencies are installed inside each image.
node_modules
**/node_modules

# Git metadata is not needed in runtime images.
.git
.gitignore
.gitattributes

# Local secrets must never enter the Docker build context.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Framework and compiler output is rebuilt inside the image.
.next
**/.next
dist
**/dist
build
**/build
.expo
**/.expo
coverage
**/coverage

# Local caches, logs, and editor metadata.
.pnpm-store
**/.pnpm-store
*.log
**/*.log
.vscode
.idea
.DS_Store
Thumbs.db

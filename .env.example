# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=travel_guard
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/travel_guard"

# Expo
EXPO_PUBLIC_API_BASE_URL=http://172.19.80.1:3000
EXPO_PUBLIC_AGORA_APP_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agora
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# AWS S3
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Security and retention
DATA_RETENTION_DAYS="30"

# JWT signing secret used by case-access tokens
AUTH_SECRET=""

# true: 가짜 응답 사용 / false: 실제 OpenAI API 호출
AI_MOCK_MODE=true

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=travel_guard
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/travel_guard"

# Expo
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_AGORA_APP_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Speech-to-Text (server only)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Agora
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Google Maps
# Web browser rendering only. Restrict by allowed domains and APIs.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Server-side Places, Geocoding, and Routes only. Never ship this key in the mobile or web client bundle.
GOOGLE_MAPS_SERVER_API_KEY=""

# AWS S3
AWS_REGION="ap-northeast-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Security and retention
DATA_RETENTION_DAYS="30"

# JWT signing secret used by case-access tokens
AUTH_SECRET=""

# true: 가짜 응답 사용 / false: 실제 OpenAI API 호출
AI_MOCK_MODE=true
